{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["\\.nix$"],
      "matchStrings": [
        "\"(?<depName>[\\w-]+/[\\w-]+)@(?<currentValue>[\\w.]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
